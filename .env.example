# Server Configuration
PORT=3000
HOST=0.0.0.0

# MongoDB Atlas or Local Connection String
# Example Atlas format: mongodb+srv://<username>:<password>@<cluster-host>/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
DB_NAME=portfolio

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password
